{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "language",
      "type": "pickString",
      "description": "Language track",
      "options": ["cpp", "csharp", "go", "java", "python", "typescript"],
      "default": "python"
    },
    {
      "id": "modulePath",
      "type": "promptString",
      "description": "Repository-relative module path",
      "default": "languages/python/01-foundations/types-and-io"
    },
    {
      "id": "level",
      "type": "pickString",
      "description": "Course level",
      "options": ["01-foundations", "02-core", "03-advanced", "04-expert"],
      "default": "01-foundations"
    },
    {
      "id": "module",
      "type": "promptString",
      "description": "Canonical module key",
      "default": "types-and-io"
    },
    {
      "id": "exercise",
      "type": "pickString",
      "description": "Exercise number",
      "options": ["01", "02"],
      "default": "01"
    },
    {
      "id": "hintStage",
      "type": "pickString",
      "description": "Hint stage: conceptual, structural, or idiomatic API",
      "options": ["1", "2", "3"],
      "default": "1"
    },
    {
      "id": "checkpointKind",
      "type": "pickString",
      "description": "Checkpoint kind",
      "options": ["project", "assessment"],
      "default": "project"
    }
  ],
  "tasks": [
    {
      "label": "Course: doctor",
      "type": "shell",
      "command": "python",
      "args": ["scripts/automation.py", "doctor", "--language", "${input:language}"],
      "problemMatcher": [],
      "options": {"cwd": "${workspaceFolder}"}
    },
    {
      "label": "Course: run module",
      "type": "shell",
      "command": "python",
      "args": ["scripts/automation.py", "run-module", "--module-path", "${input:modulePath}"],
      "problemMatcher": [],
      "options": {"cwd": "${workspaceFolder}"}
    },
    {
      "label": "Course: verify language",
      "type": "shell",
      "command": "python",
      "args": ["scripts/automation.py", "verify-language", "--language", "${input:language}"],
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": [],
      "options": {"cwd": "${workspaceFolder}"}
    },
    {
      "label": "Course: check exercise",
      "type": "shell",
      "command": "python",
      "args": [
        "scripts/automation.py",
        "check-exercise",
        "--language", "${input:language}",
        "--level", "${input:level}",
        "--module", "${input:module}",
        "--exercise", "${input:exercise}"
      ],
      "group": "test",
      "problemMatcher": [],
      "options": {"cwd": "${workspaceFolder}"}
    },
    {
      "label": "Course: hint exercise",
      "type": "shell",
      "command": "python",
      "args": [
        "scripts/automation.py",
        "hint-exercise",
        "--language", "${input:language}",
        "--level", "${input:level}",
        "--module", "${input:module}",
        "--exercise", "${input:exercise}",
        "--stage", "${input:hintStage}"
      ],
      "problemMatcher": [],
      "options": {"cwd": "${workspaceFolder}"}
    },
    {
      "label": "Course: check checkpoint",
      "type": "shell",
      "command": "python",
      "args": [
        "scripts/automation.py",
        "check-checkpoint",
        "--language", "${input:language}",
        "--kind", "${input:checkpointKind}",
        "--level", "${input:level}"
      ],
      "group": "test",
      "problemMatcher": [],
      "options": {"cwd": "${workspaceFolder}"}
    },
    {
      "label": "Repository: tests and structure",
      "type": "shell",
      "command": "python",
      "args": ["scripts/automation.py", "test-automation"],
      "group": "test",
      "problemMatcher": [],
      "options": {"cwd": "${workspaceFolder}"}
    }
  ]
}
