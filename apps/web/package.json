{
    "name": "programming-examples-web",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "sandbox:probe": "node --env-file=.env.local scripts/sandbox-probe.mjs",
        "content": "node scripts/content.mjs",
        "dev": "npm run content && next dev",
        "build": "npm run content && next build",
        "start": "next start",
        "typecheck": "tsc --noEmit",
        "lint": "prettier --check .",
        "format": "prettier --write .",
        "test": "npm run content && node --test tests/*.test.mjs",
        "test:browser": "playwright test",
        "test:sandbox": "node --env-file=.env.local scripts/test-sandbox.mjs --all"
    },
    "dependencies": {
        "@monaco-editor/react": "^4.7.0",
        "@supabase/ssr": "^0.12.6",
        "@supabase/supabase-js": "^2.116.0",
        "@vercel/sandbox": "3.2.1",
        "idb": "^8.0.3",
        "monaco-editor": "^0.56.0",
        "next": "^16.3.4",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-markdown": "^10.1.0",
        "rehype-sanitize": "^6.0.0",
        "rehype-slug": "^6.0.0",
        "remark-gfm": "^4.0.1",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@electric-sql/pglite": "^0.5.8",
        "@playwright/test": "^1.63.0",
        "@types/node": "^22.20.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "prettier": "^3.9.6",
        "typescript": "^5.9.3"
    },
    "overrides": {
        "dompurify": "3.4.15"
    }
}
