{
  "case_sets": {
    "types-and-io-01": [
      {
        "name": "numeric summary",
        "input_lines": ["3", "10", "20", "30"],
        "required_stdout_contains": [
          "Sum: 60",
          "Average: 20",
          "Minimum: 10",
          "Maximum: 30"
        ]
      },
      {
        "name": "non-positive count",
        "input_lines": ["0"],
        "required_stdout_contains": ["positive"]
      }
    ],
    "types-and-io-02": [
      {
        "name": "invoice total",
        "input_lines": ["notebook 2.50 4"],
        "required_stdout_contains": ["Product: notebook"],
        "required_stdout_patterns": ["Total(?: price)?: 10(?:\\.0+)?"]
      },
      {
        "name": "zero quantity",
        "input_lines": ["notebook 2.50 0"],
        "required_stdout_contains": ["Product: notebook"],
        "required_stdout_patterns": ["Total(?: price)?: 0(?:\\.0+)?"]
      }
    ]
  },
